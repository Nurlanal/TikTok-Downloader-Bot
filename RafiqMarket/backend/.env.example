# ---- Server ----
NODE_ENV=production
PORT=8080
# Tətbiqin serverə müraciət etdiyi ictimai HTTPS ünvanı (ödəniş callback-ləri üçün)
PUBLIC_BASE_URL=https://api.rafiqmarket.az
DATABASE_URL=postgres://rafiq:STRONG_PASSWORD@localhost:5432/rafiq
# Ən azı 32 simvol təsadüfi sətir: openssl rand -hex 48
JWT_SECRET=CHANGE_ME
OTP_PEPPER=CHANGE_ME_TOO
# Market saat qurşağı (çatdırılma saatları və statistikalar üçün)
TZ=Asia/Baku

# ---- SMS (OTP) ---- REAL AÇAR TƏLƏB OLUNUR
# twilio | console   (console yalnız NODE_ENV=development-də icazəlidir)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Onlayn ödəniş: Epoint (epoint.az) ---- REAL AÇAR TƏLƏB OLUNUR
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_API_BASE=https://epoint.az/api/1

# ---- Firebase Cloud Messaging ---- REAL AÇAR TƏLƏB OLUNUR
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/rafiq/firebase-service-account.json
