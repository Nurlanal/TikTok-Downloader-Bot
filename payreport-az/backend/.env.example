# PayReport AZ backend konfiqurasiyası
# Bu faylı .env adı ilə kopyalayın və dəyərləri doldurun. .env faylını heç vaxt git-ə əlavə etməyin.

PORT=8080
HOST=127.0.0.1
# nginx/Caddy kimi HTTPS tərs proksi arxasındasınızsa 1 edin
TRUST_PROXY=1
# Birbaşa HTTPS üçün (tərs proksi olmadan):
TLS_CERT_FILE=
TLS_KEY_FILE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=payreport
DB_USER=payreport
DB_PASSWORD=dəyişdirin

# Mail şifrəsini şifrələmək üçün 32 baytlıq açar (base64). Yaratmaq: npm run gen-key
# Bu açarı itirsəniz, saxlanmış mail şifrəsini yenidən daxil etməli olacaqsınız.
CREDENTIALS_KEY=

TOKEN_TTL_DAYS=30
SYNC_ENABLED=1
SYNC_INTERVAL_MINUTES=5
MAX_MESSAGES_PER_RUN=500

# Şəkil qəbzləri üçün serverdə OCR (tesseract.js). Dil faylları ilk istifadədə yüklənir.
OCR_ENABLED=0
OCR_LANGUAGES=eng+aze
